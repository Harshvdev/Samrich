# — Samrich Poems & Stories | Env Example —
# Copy this to .env.local and fill in real values:
#   cp .env.example .env.local
#
# Uses MODERN Supabase keys only. Legacy anon / service_role JWT keys are
# deprecated (removal end of 2026) — do not use them for new code.
# NEVER commit real keys. .env.local is git-ignored by Next.js by default.

# ─────────────────────────────────────────────
# 1) NEXT_PUBLIC_SUPABASE_URL
# What: Your Supabase project URL. Looks like https://xyzcompany.supabase.co
# Where to find it:
#   1. Go to https://supabase.com/dashboard
#   2. Select your project (create one if needed: New Project)
#   3. Click gear icon (Project Settings) > Data API / Configuration
#   4. Copy "Project URL" / "Supabase URL"
# Used for: all Supabase client + server calls
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# ─────────────────────────────────────────────
# 2) NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# What: Publishable key, starts with sb_publishable_... Safe to expose in browser (respects RLS).
#        Modern replacement for legacy `anon` key. DO NOT USE anon.
# Where to find it:
#   1. Dashboard > Select project > Project Settings > API Keys
#   2. Select "Publishable and secret API keys" tab (NOT Legacy)
#   3. If empty, click "Create new API keys" — this creates `default` publishable + secret alongside legacy (safe, legacy keeps working until you disable it)
#   4. Copy publishable key (sb_publishable_...)
# Used for: browser Supabase client, public reads, auth
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ─────────────────────────────────────────────
# 3) SUPABASE_SECRET_KEY
# What: Secret key, starts with sb_secret_... BYPASSES RLS. SERVER ONLY.
#        Modern replacement for legacy `service_role` key. DO NOT USE service_role.
# Where to find it:
#   1. Same page: Project Settings > API Keys > Publishable and secret tab
#   2. Under Secret keys / `default`, click Reveal to copy (sb_secret_...)
#   3. In Vercel: Project > Settings > Environment Variables > add as secret (Production + Preview), WITHOUT NEXT_PUBLIC_ prefix
# WARNING: Never prefix with NEXT_PUBLIC_, never commit it, never send to browser. Using it in browser returns HTTP 401.
# Used for: Server Actions / Route Handlers that need admin bypass (revalidation, moderation, seeding)
# ─────────────────────────────────────────────
SUPABASE_SECRET_KEY=""

# ─────────────────────────────────────────────
# 4) NEXT_PUBLIC_SITE_URL
# What: Canonical base URL of your site. No trailing slash.
# Where to find / what to put:
#   - Local dev: http://localhost:3000
#   - Vercel Preview: https://your-preview.vercel.app (copy from Vercel deployment URL)
#   - Production: https://yourdomain.com (your custom domain, or https://your-project.vercel.app)
#   - After you set production: also add it in Supabase Dashboard > Authentication > URL Configuration > Redirect URLs + Site URL
# Used for: SEO canonical, sitemap.xml, robots.txt, OG/Twitter cards, share links, auth redirects, preview links
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

